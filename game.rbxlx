          <string name="Name">LobbyManager</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- LobbyManager.server.luau
-- Gerencia lobby e matchmaking

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

print("🎮 LobbyManager iniciado...")

-- Criar Lobby no workspace
local lobbyFolder = Instance.new("Folder")
lobbyFolder.Name = "Lobby"
lobbyFolder.Parent = workspace

-- Remotes
local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not RemotesFolder then
	RemotesFolder = Instance.new("Folder")
	RemotesFolder.Name = "Remotes"
	RemotesFolder.Parent = ReplicatedStorage
end

local EnterGameRemote = Instance.new("RemoteFunction")
EnterGameRemote.Name = "EnterGame"
EnterGameRemote.Parent = RemotesFolder

-- Matchmaking zones
local zones = {}
for i = 1, 3 do
	zones[i] = {
		id = i,
		name = "Zone" .. i,
		players = {},
		maxPlayers = 10,
		countdownTime = 15,
		isCountingDown = false,
	}
	
	-- Criar zona visual
	local zoneModel = Instance.new("Part")
	zoneModel.Name = "Zone_" .. i
	zoneModel.Shape = Enum.PartType.Block
	zoneModel.Size = Vector3.new(50, 1, 50)
	zoneModel.Position = Vector3.new((i - 2) * 80, 5, 0)
	zoneModel.CanCollide = false
	zoneModel.Transparency = 0.5
	zoneModel.BrickColor = BrickColor.new("Neon green")
	zoneModel.Parent = lobbyFolder
	zoneModel:SetAttribute("zoneId", i)
end

-- Entrar na zona
EnterGameRemote.OnServerInvoke = function(player, zoneId, groupSize)
	local zone = zones[zoneId]
	if not zone then
		return {success = false, message = "Zona inválida"}
	end
	
	if #zone.players >= zone.maxPlayers then
		return {success = false, message = "Zona cheia"}
	end
	
	table.insert(zone.players, player)
	print("✅ " .. player.Name .. " entrou na " .. zone.name .. " (jogadores: " .. #zone.players .. ")")
	
	-- Iniciar countdown se requisitado
	if groupSize and #zone.players >= groupSize then
		if not zone.isCountingDown then
			zone.isCountingDown = true
			print("🎮 Iniciando matchmaking...")
			-- TODO: Começar jogo
		end
	end
	
	return {success = true, message = "Entrou na zona", zone = zone}
end

print("✅ LobbyManager pronto!")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">MobSpawner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- MobSpawner.server.luau
-- Spawna mobs durante noite

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

print("👹 MobSpawner iniciado...")

-- Remotes
local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
local DayNightChangedEvent = RemotesFolder and RemotesFolder:FindFirstChild("DayNightChanged")

local spawnedMobs = {}
local isNight = false

-- Criar mob
local function spawnMob()
	local mobFolder = Instance.new("Folder")
	mobFolder.Name = "Mob_" .. tick()
	mobFolder.Parent = workspace
	
	-- Corpo do mob
	local body = Instance.new("Part")
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(2, 2, 2)
	body.Color = Color3.fromRGB(200, 50, 50)
	body.Position = Vector3.new(math.random(-100, 100), 5, math.random(-100, 100))
	body.CanCollide = true
	body.Parent = mobFolder
	
	-- Humanoid
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 20
	humanoid.Health = 20
	humanoid.Parent = mobFolder
	
	local mob = {
		folder = mobFolder,
		body = body,
		humanoid = humanoid,
		health = 20,
		lastAttackTime = 0,
	}
	
	table.insert(spawnedMobs, mob)
	print("👹 Mob spawned: " .. mobFolder.Name)
	
	return mob
end

-- Destruir mob
local function killMob(mob)
	if mob.folder.Parent then
		mob.folder:Destroy()
	end
	table.remove(spawnedMobs, table.find(spawnedMobs, mob))
	print("💀 Mob morreu")
end

-- Ao mudar dia/noite
if DayNightChangedEvent then
	DayNightChangedEvent.OnServerEvent:Connect(function(data)
		isNight = data.isNight
		
		if isNight then
			print("👹 Spawning mobs...")
			for i = 1, 5 do
				spawnMob()
			end
		else
			print("☀️ Removendo mobs...")
			for _, mob in pairs(spawnedMobs) do
				killMob(mob)
			end
		end
	end)
end

-- AI simples dos mobs (perseguir jogadores)
RunService.Heartbeat:Connect(function()
	local players = game:GetService("Players"):GetPlayers()
	
	for _, mob in pairs(spawnedMobs) do
		if mob.body and mob.body.Parent then
			-- Encontrar jogador mais próximo
			local closest = nil
			local minDist = math.huge
			
			for _, player in pairs(players) do
				if player.Character then
					local charPos = player.Character:FindFirstChild("HumanoidRootPart")
					if charPos then
						local dist = (mob.body.Position - charPos.Position).Magnitude
						if dist < minDist and dist < 50 then
							minDist = dist
							closest = charPos
						end
					end
				end
			end
			
			-- Mover em direção ao jogador
			if closest then
				local direction = (closest.Position - mob.body.Position).Unit
				mob.body.Velocity = direction * 30
			end
		end
	end
end)

print("✅ MobSpawner pronto!")
]]></string>
        </Properties>
