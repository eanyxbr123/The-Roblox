          <string name="Source"><![CDATA[-- init.client.luau
-- Inicialização do cliente

print("🎮 Initializing Survival Game Client...")

-- Os sistemas de UI de inventário, construção e intera\u00e7\u00e3o com itens rodam como LocalScripts em StarterPlayerScripts.
-- N\u00e3o use require() em LocalScripts aqui.

print("✅ Client systems loaded!")
print("🎯 Controls:")
print("  - I: Open inventory")
print("  - B: Open construction menu")
print("  - Hover near items and drag to collect (❌❌❌ NOVO SISTEMA)")
]]></string>
