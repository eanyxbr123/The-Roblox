          <string name="Name">DataStoreSystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- DataStoreSystem.server.luau
-- Salvar e carregar dados dos jogadores

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

print("💾 DataStoreSystem iniciado...")

-- Criar DataStore
local playerDataStore = DataStoreService:GetDataStore("PlayerData")

-- Estrutura padrão
local defaultPlayerData = {
	nightsSurvived = 0,
	money = 1000,
	crystals = 50,
	unlockedClasses = {police = true},
	stats = {
		totalKills = 0,
		totalBlocksMined = 0,
		totalItemsCrafted = 0,
	},
}

-- Salvar dados
local function savePlayerData(player)
	local userId = player.UserId
	
	-- TODO: Coletar dados do jogador
	local playerData = defaultPlayerData
	
	xpcall(function()
		playerDataStore:SetAsync("Player_" .. userId, playerData)
		print("💾 Dados salvos para " .. player.Name)
	end, function(err)
		warn("❌ Erro ao salvar dados: " .. err)
	end)
end

-- Carregar dados
local function loadPlayerData(player)
	local userId = player.UserId
	
	xpcall(function()
		local data = playerDataStore:GetAsync("Player_" .. userId)
		if data then
			print("✅ Dados carregados para " .. player.Name)
			return data
		else
			print("📝 Novos dados para " .. player.Name)
			return defaultPlayerData
		end
	end, function(err)
		warn("❌ Erro ao carregar dados: " .. err)
		return defaultPlayerData
	end)
end

-- Auto-save a cada 5 minutos
Players.PlayerAdded:Connect(function(player)
	spawn(function()
		while player.Parent do
			wait(300)
			savePlayerData(player)
		end
	end)
end)

-- Salvar ao sair
Players.PlayerRemoving:Connect(function(player)
	savePlayerData(player)
end)

print("✅ DataStoreSystem pronto!")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">DayNightSystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- DayNightSystem.server.luau
-- Controla ciclo dia/noite

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

print("🌙 DayNightSystem iniciado...")

local DayNightSystem = {}

-- Configuração
DayNightSystem.cycleDuration = 60 -- 60 segundos por ciclo
DayNightSystem.dayDuration = 30
DayNightSystem.nightDuration = 30
DayNightSystem.isNight = false
DayNightSystem.currentNight = 0
DayNightSystem.maxNights = 99

-- Remotes
local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not RemotesFolder then
	RemotesFolder = Instance.new("Folder")
	RemotesFolder.Name = "Remotes"
	RemotesFolder.Parent = ReplicatedStorage
end

local DayNightChangedEvent = Instance.new("RemoteEvent")
DayNightChangedEvent.Name = "DayNightChanged"
DayNightChangedEvent.Parent = RemotesFolder

-- Mudar para noite
local function setNight(night)
	DayNightSystem.isNight = true
	DayNightSystem.currentNight = night
	
	-- Mudar lighting
	Lighting.Brightness = 0.2
	Lighting.Ambient = Color3.fromRGB(100, 100, 150)
	
	print("🌙 Noite " .. night .. " / " .. DayNightSystem.maxNights)
	DayNightChangedEvent:FireAllClients({
		isNight = true,
		night = night,
		maxNights = DayNightSystem.maxNights,
	})
end

-- Mudar para dia
local function setDay()
	DayNightSystem.isNight = false
	
	-- Mudar lighting
	Lighting.Brightness = 1.5
	Lighting.Ambient = Color3.fromRGB(200, 200, 200)
	
	print("☀️ Dia começou")
	DayNightChangedEvent:FireAllClients({
		isNight = false,
		night = DayNightSystem.currentNight,
		maxNights = DayNightSystem.maxNights,
	})
end

-- Loop de ciclo
local elapsedTime = 0
game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
	elapsedTime = elapsedTime + deltaTime
	
	if elapsedTime >= DayNightSystem.cycleDuration then
		elapsedTime = 0
		
		if DayNightSystem.isNight then
			setDay()
		else
			DayNightSystem.currentNight = DayNightSystem.currentNight + 1
			if DayNightSystem.currentNight > DayNightSystem.maxNights then
				DayNightSystem.currentNight = 1
			end
			setNight(DayNightSystem.currentNight)
		end
	end
end)

-- Começar com dia
setDay()

print("✅ DayNightSystem pronto!")
return DayNightSystem
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">InventorySystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- InventorySystem.luau (ModuleScript)
-- Gerencia inventários dos jogadores no servidor

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local Inventory = require(ReplicatedStorage.Shared.Inventory)

-- Remotes
local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not RemotesFolder then
	RemotesFolder = Instance.new("Folder")
	RemotesFolder.Name = "Remotes"
	RemotesFolder.Parent = ReplicatedStorage
end

local GetInventoryRemote = Instance.new("RemoteFunction")
GetInventoryRemote.Name = "GetInventory"
GetInventoryRemote.Parent = RemotesFolder

-- Armazenar inventários
local playerInventories = {}

-- Inicializar inventário do jogador
local function initPlayerInventory(player: Player)
	if not playerInventories[player] then
		playerInventories[player] = Inventory.new(1)
		-- Dar itens iniciais
		Inventory.addItem(playerInventories[player], "wood", 5, ItemDefinitions)
		Inventory.addItem(playerInventories[player], "stone", 3, ItemDefinitions)
		print("📦 Inventário criado para " .. player.Name)
	end
end

-- Obter inventário
GetInventoryRemote.OnServerInvoke = function(player: Player)
	if not playerInventories[player] then
		initPlayerInventory(player)
	end
	return playerInventories[player]
end

-- Cleanup
Players.PlayerAdded:Connect(initPlayerInventory)
Players.PlayerRemoving:Connect(function(player)
	playerInventories[player] = nil
end)

print("✅ InventorySystem carregado!")

local InventorySystem = {}
function InventorySystem.addItem(player: Player, itemId: string, quantity: number)
	if playerInventories[player] then
		return Inventory.addItem(playerInventories[player], itemId, quantity, ItemDefinitions)
	end
end

return InventorySystem
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
