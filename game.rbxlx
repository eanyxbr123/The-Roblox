	id = "wooden_pickaxe",
	name = "Picareta de Madeira",
	pattern = {
		{"wood", "wood", "wood"},
		{nil, "stone", nil},
		{nil, "stone", nil},
	},
	output = {item = "wooden_pickaxe", quantity = 1},
	inputs = {wood = 3, stone = 2},
}

CraftRecipes["stone_pickaxe"] = {
	id = "stone_pickaxe",
	name = "Picareta de Pedra",
	pattern = {
		{"stone", "stone", "stone"},
		{nil, "wood", nil},
		{nil, "wood", nil},
	},
	output = {item = "stone_pickaxe", quantity = 1},
	inputs = {stone = 3, wood = 2},
}

CraftRecipes["sword"] = {
	id = "sword",
	name = "Espada",
	pattern = {
		{nil, "stone", nil},
