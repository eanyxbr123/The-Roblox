        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">ConstructionClient</string>
            <string name="Source">-- ConstructionClient.client.luau
-- Cliente do sistema de construção estilo The Forest

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local BuildStructureRemote = require(ReplicatedStorage.Shared.Remotes.BuildStructure)
local GetAvailableStructuresRemote = require(ReplicatedStorage.Shared.Remotes.GetAvailableStructures)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function createPreviewModel(structure, cframe)
	local model = Instance.new("Model")
	model.Name = "ConstructionPreview"

	local part = Instance.new("Part")
	part.Size = structure.size or Vector3.new(4, 2, 4)
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 0.5
	part.Color = structure.color or Color3.fromRGB(170, 170, 170)
	part.Parent = model

	local mesh = Instance.new("BlockMesh")
	mesh.Parent = part

	model.PrimaryPart = part
	return model
end

local function snapToGrid(position, gridSize)
	gridSize = gridSize or 4
	return Vector3.new(
		math.round(position.X / gridSize) * gridSize,
		math.round(position.Y / gridSize) * gridSize,
		math.round(position.Z / gridSize) * gridSize
	)
end

-- Criar GUI do menu radial
local radialMenu = Instance.new("ScreenGui")
radialMenu.Name = "ConstructionRadialMenu"
radialMenu.ResetOnSpawn = false
radialMenu.Enabled = false
radialMenu.Parent = playerGui

-- Background escuro
local background = Instance.new("Frame")
background.Name = "Background"
background.Size = UDim2.new(1, 0, 1, 0)
background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
background.BackgroundTransparency = 0.7
background.Parent = radialMenu

-- Container do menu radial
local radialContainer = Instance.new("Frame")
radialContainer.Name = "RadialContainer"
radialContainer.Size = UDim2.new(0, 400, 0, 400)
radialContainer.Position = UDim2.new(0.5, -200, 0.5, -200)
radialContainer.BackgroundTransparency = 1
radialContainer.Parent = radialMenu

-- Centro do menu
local centerButton = Instance.new("TextButton")
centerButton.Name = "CenterButton"
centerButton.Size = UDim2.new(0, 80, 0, 80)
centerButton.Position = UDim2.new(0.5, -40, 0.5, -40)
centerButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
centerButton.Text = "🏗️"
centerButton.TextSize = 24
centerButton.Parent = radialContainer

local centerCorner = Instance.new("UICorner")
centerCorner.CornerRadius = UDim.new(1, 0)
centerCorner.Parent = centerButton

-- Botões das categorias
local categories = {
	{name = "Culinária", key = "cooking", icon = "🍳", color = Color3.fromRGB(255, 150, 50)},
	{name = "Defesa", key = "defense", icon = "🛡️", color = Color3.fromRGB(150, 50, 50)},
	{name = "Abrigo", key = "shelter", icon = "🏠", color = Color3.fromRGB(100, 150, 255)},
}

local categoryButtons = {}

for i, category in ipairs(categories) do
	local angle = (i - 1) * (360 / #categories) - 90 -- Começar do topo
	local radian = math.rad(angle)
	local distance = 120

	local button = Instance.new("TextButton")
	button.Name = category.name .. "Button"
	button.Size = UDim2.new(0, 60, 0, 60)
	button.Position = UDim2.new(0.5, math.cos(radian) * distance - 30, 0.5, math.sin(radian) * distance - 30)
	button.BackgroundColor3 = category.color
	button.Text = category.icon
	button.TextSize = 20
	button.Parent = radialContainer

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = button

	categoryButtons[category.name] = button
end

-- Menu de itens de construção (inicialmente invisível)
local itemMenu = Instance.new("Frame")
itemMenu.Name = "ItemMenu"
itemMenu.Size = UDim2.new(0, 300, 0, 400)
itemMenu.Position = UDim2.new(0.5, 250, 0.5, -200)
itemMenu.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
itemMenu.BorderSizePixel = 2
itemMenu.Visible = false
itemMenu.Parent = radialMenu

local itemCorner = Instance.new("UICorner")
itemCorner.CornerRadius = UDim.new(0, 8)
itemCorner.Parent = itemMenu

local itemScroll = Instance.new("ScrollingFrame")
itemScroll.Name = "ItemScroll"
itemScroll.Size = UDim2.new(1, -20, 1, -60)
itemScroll.Position = UDim2.new(0, 10, 0, 50)
itemScroll.BackgroundTransparency = 1
itemScroll.ScrollBarThickness = 6
itemScroll.Parent = itemMenu

local itemListLayout = Instance.new("UIListLayout")
itemListLayout.Padding = UDim.new(0, 5)
itemListLayout.Parent = itemScroll

local itemTitle = Instance.new("TextLabel")
itemTitle.Name = "Title"
itemTitle.Size = UDim2.new(1, 0, 0, 40)
itemTitle.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
itemTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
itemTitle.TextSize = 16
itemTitle.Font = Enum.Font.GothamBold
itemTitle.Text = "Selecione Item"
itemTitle.Parent = itemMenu

-- Estado do sistema
local isMenuOpen = false
local selectedCategory = nil
local selectedStructure = nil
local previewModel = nil

-- Função para abrir/fechar menu radial
local function toggleRadialMenu()
	isMenuOpen = not isMenuOpen
	radialMenu.Enabled = isMenuOpen

	if not isMenuOpen then
		itemMenu.Visible = false
		selectedCategory = nil
		selectedStructure = nil
		if previewModel then
			previewModel:Destroy()
			previewModel = nil
		end
	end
end

-- Função para mostrar itens de uma categoria
local function showCategoryItems(categoryName, categoryKey)
	selectedCategory = categoryKey
	itemTitle.Text = categoryName

	-- Limpar itens anteriores
	for _, child in pairs(itemScroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	-- Obter estruturas disponíveis do servidor
	local availableStructures = GetAvailableStructuresRemote:InvokeServer()

	if availableStructures and availableStructures[categoryKey] then
		for _, structure in pairs(availableStructures[categoryKey]) do
			local itemButton = Instance.new("TextButton")
			itemButton.Name = structure.id
			itemButton.Size = UDim2.new(1, 0, 0, 50)
			itemButton.BackgroundColor3 = structure.canBuild and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(80, 80, 80)
			itemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			itemButton.TextSize = 14
			itemButton.Font = Enum.Font.Gotham
			itemButton.Text = structure.name .. (structure.canBuild and "" or " (recursos insuficientes)")
			itemButton.AutoButtonColor = structure.canBuild
			itemButton.Parent = itemScroll

			local buttonCorner = Instance.new("UICorner")
			buttonCorner.CornerRadius = UDim.new(0, 4)
			buttonCorner.Parent = itemButton

			-- Hover effect
			itemButton.MouseEnter:Connect(function()
				if structure.canBuild then
					itemButton.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
				end
			end)

			itemButton.MouseLeave:Connect(function()
				if structure.canBuild then
					itemButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
				end
			end)

			-- Selecionar item
			itemButton.MouseButton1Click:Connect(function()
				if not structure.canBuild then
					print("❌ Recursos insuficientes para " .. structure.name)
					return
				end

				selectedStructure = structure
				itemMenu.Visible = false
				radialMenu.Enabled = false
				startPlacementMode(structure)
			end)
		end
	else
		local noItemsLabel = Instance.new("TextLabel")
		noItemsLabel.Size = UDim2.new(1, 0, 0, 30)
		noItemsLabel.BackgroundTransparency = 1
		noItemsLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		noItemsLabel.TextSize = 12
		noItemsLabel.Text = "Nenhum item disponível"
		noItemsLabel.Parent = itemScroll
	end

	itemMenu.Visible = true
end

-- Modo de colocação
function startPlacementMode(structure)
	print("🏗️ Placement mode: " .. structure.name)

	-- Criar preview
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local rootPart = character.HumanoidRootPart

		-- Calcular posição à frente do jogador
		local forward = rootPart.CFrame.LookVector
		local position = rootPart.Position + forward * 5

		-- Criar preview model local simples
		previewModel = createPreviewModel(structure, CFrame.new(position))
		if previewModel then
			previewModel.Parent = workspace
		end
	end

	-- Conectar movimento do mouse para mover preview
	local mouse = player:GetMouse()

	local function updatePreview()
		if previewModel and selectedStructure then
			local character = player.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local rootPart = character.HumanoidRootPart
				local forward = rootPart.CFrame.LookVector
				local position = rootPart.Position + forward * 5

			-- Aplicar snap no grid local
			local snapped = snapToGrid(position, 4)
			previewModel:PivotTo(CFrame.new(snapped))
			end
		end
	end

	-- Conectar eventos
	local moveConnection = mouse.Move:Connect(updatePreview)
	local clickConnection = mouse.Button1Down:Connect(function()
		-- Construir estrutura
		if previewModel and selectedStructure then
			local position = previewModel:GetPivot().Position
			local success, message = BuildStructureRemote:InvokeServer(selectedStructure.id, position)

			if success then
				print("✅ Built " .. selectedStructure.name)
			else
				print("❌ Failed to build " .. selectedStructure.name .. " (" .. tostring(message) .. ")")
			end
		end

		-- Limpar
		if previewModel then
			previewModel:Destroy()
			previewModel = nil
		end

		selectedStructure = nil
		moveConnection:Disconnect()
		clickConnection:Disconnect()
	end)

	-- Cancelar com botão direito
	local rightClickConnection = mouse.Button2Down:Connect(function()
		if previewModel then
			previewModel:Destroy()
			previewModel = nil
		end

		selectedStructure = nil
		moveConnection:Disconnect()
		clickConnection:Disconnect()
		rightClickConnection:Disconnect()
	end)
end

-- Conectar botões das categorias
for _, category in ipairs(categories) do
	local button = categoryButtons[category.name]
	if button then
		button.MouseButton1Click:Connect(function()
			showCategoryItems(category.name, category.key)
		end)
	end
end

-- Fechar menu ao clicar no centro
centerButton.MouseButton1Click:Connect(function()
	toggleRadialMenu()
end)

-- Fechar menu ao clicar no background
background.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		toggleRadialMenu()
	end
end)

-- Registrar tecla para abrir menu (B)
ContextActionService:BindAction("ToggleConstructionMenu", function(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		toggleRadialMenu()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.B)

ContextActionService:SetTitle("ToggleConstructionMenu", "Abrir Menu de Construção")
ContextActionService:SetPosition("ToggleConstructionMenu", UDim2.new(0, 0, 0, 0))

print("🏗️ Construction client loaded! Press B to open construction menu")</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">InventoryClient</string>
            <string name="Source"><![CDATA[-- InventoryClient.client.luau
-- GUI de inventário no cliente

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)
local CraftRecipes = require(ReplicatedStorage.Shared.CraftRecipes)
local Inventory = require(ReplicatedStorage.Shared.Inventory)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Carregar remotes da pasta shared
local CraftRemote = require(ReplicatedStorage.Shared.Remotes.CraftItem)
local GetInventoryRemote = require(ReplicatedStorage.Shared.Remotes.GetInventory)
local AddItemRemote = require(ReplicatedStorage.Shared.Remotes.AddItem)

-- UI Setup - Aguardar GUI do servidor
local screenGui = playerGui:WaitForChild("InventoryGui", 10)
if not screenGui then
	warn("❌ GUI do inventário não encontrada no PlayerGui")
	return
end

local inventoryWindow = screenGui:WaitForChild("InventoryWindow")

-- Referenciar elementos da GUI
local titleLabel = inventoryWindow:WaitForChild("Title")
local inventoryGrid = inventoryWindow:WaitForChild("InventoryGrid")
local craftingArea = inventoryWindow:WaitForChild("CraftingArea")
local craftingGrid = craftingArea:WaitForChild("CraftingGrid")
local resultSlot = craftingArea:WaitForChild("ResultSlot")
local craftButton = craftingArea:WaitForChild("CraftButton")

print("✅ GUI do inventário carregada com sucesso")

-- Estado do crafting grid (3x3)
local craftingSlots = {} -- {row_col: itemId}

-- Função para atualizar inventário em grid
local function updateInventoryGrid()
	local inv = GetInventoryRemote:InvokeServer()

	-- Limpar grid anterior
	for _, slot in pairs(inventoryGrid:GetChildren()) do
		if slot:IsA("Frame") and slot.Name:match("^Slot%d+$") then
			local itemImage = slot:FindFirstChild("ItemImage")
			local quantityLabel = slot:FindFirstChild("Quantity")
			if itemImage then itemImage.Visible = false end
			if quantityLabel then quantityLabel.Text = "" end
		end
	end

	-- Preencher grid com itens
	for slotNum = 1, inv.maxSlots do
		local slot = inventoryGrid:FindFirstChild("Slot" .. slotNum)
		if slot then
			local slotData = inv.slots[slotNum]
			local itemImage = slot:FindFirstChild("ItemImage")
			local quantityLabel = slot:FindFirstChild("Quantity")

			if slotData and itemImage and quantityLabel then
				local itemDef = ItemDefinitions[slotData.item]
				if itemDef then
					-- TODO: Adicionar sistema de imagens de itens
					itemImage.Visible = true
					itemImage.Image = "rbxassetid://0" -- Placeholder
					itemImage.BackgroundColor3 = itemDef.rarity == "common" and Color3.fromRGB(150, 150, 150) or
					                            itemDef.rarity == "uncommon" and Color3.fromRGB(100, 200, 100) or
					                            itemDef.rarity == "rare" and Color3.fromRGB(100, 150, 255) or
					                            itemDef.rarity == "epic" and Color3.fromRGB(200, 100, 255) or
					                            Color3.fromRGB(255, 200, 100) -- legendary

					if slotData.quantity > 1 then
						quantityLabel.Text = tostring(slotData.quantity)
					else
						quantityLabel.Text = ""
					end
				end
			end
		end
	end

	-- Atualizar título com informações do inventário
	local weightText = string.format("%.1f/%.1f kg", inv.totalWeight, inv.maxWeight)
	local slotText = string.format("Level %d (%dx%d)", inv.backpackLevel, inv.columns, inv.rows)
	titleLabel.Text = string.format("📦 INVENTORY | %s | %s", weightText, slotText)
end

-- Função para atualizar crafting grid
local function updateCraftingGrid()
	-- Limpar slots de crafting
	for _, slot in pairs(craftingGrid:GetChildren()) do
		if slot:IsA("Frame") and slot.Name:match("^CraftSlot_%d+_%d+$") then
			local itemImage = slot:FindFirstChild("ItemImage")
			if itemImage then itemImage.Visible = false end
		end
	end

	-- Preencher slots de crafting
	for row = 1, 3 do
		for col = 1, 3 do
			local slotKey = row .. "_" .. col
			local itemId = craftingSlots[slotKey]
			local slot = craftingGrid:FindFirstChild("CraftSlot_" .. slotKey)

			if slot and itemId then
				local itemImage = slot:FindFirstChild("ItemImage")
				if itemImage then
					local itemDef = ItemDefinitions[itemId]
					if itemDef then
						itemImage.Visible = true
						itemImage.Image = "rbxassetid://0" -- Placeholder
						itemImage.BackgroundColor3 = itemDef.rarity == "common" and Color3.fromRGB(150, 150, 150) or
						                            itemDef.rarity == "uncommon" and Color3.fromRGB(100, 200, 100) or
						                            itemDef.rarity == "rare" and Color3.fromRGB(100, 150, 255) or
						                            itemDef.rarity == "epic" and Color3.fromRGB(200, 100, 255) or
						                            Color3.fromRGB(255, 200, 100) -- legendary
					end
				end
			end
		end
	end

	-- Verificar se há receita válida
	local resultItem = checkCraftingRecipe()
	updateCraftingResult(resultItem)
end

-- Função para verificar receita de crafting
local function checkCraftingRecipe()
	local inv = GetInventoryRemote:InvokeServer()

	-- Criar padrão atual do crafting grid
	local currentPattern = {}
	for row = 1, 3 do
		currentPattern[row] = {}
		for col = 1, 3 do
			local slotKey = row .. "_" .. col
			currentPattern[row][col] = craftingSlots[slotKey] or nil
		end
	end

	-- Verificar cada receita
	for recipeId, recipe in pairs(CraftRecipes) do
		if recipe.pattern then
			local matches = true

			-- Verificar se o padrão corresponde
			for row = 1, 3 do
				for col = 1, 3 do
					local patternItem = recipe.pattern[row] and recipe.pattern[row][col] or nil
					local gridItem = currentPattern[row][col]

					if patternItem ~= gridItem then
						matches = false
						break
					end
				end
				if not matches then break end
			end

			if matches then
				-- Verificar se tem itens suficientes no inventário
				if Inventory.hasItems(inv, ItemDefinitions, recipe) then
					return recipe
				end
			end
		end
	end

	return nil
end

-- Função para atualizar resultado do crafting
local function updateCraftingResult(recipe)
	local resultImage = resultSlot:FindFirstChild("ResultImage")
	local resultQuantity = resultSlot:FindFirstChild("ResultQuantity")

	if resultImage and resultQuantity then
		if recipe then
			local itemDef = ItemDefinitions[recipe.output.item]
			if itemDef then
				resultImage.Visible = true
				resultImage.Image = "rbxassetid://0" -- Placeholder
				resultImage.BackgroundColor3 = itemDef.rarity == "common" and Color3.fromRGB(150, 150, 150) or
				                              itemDef.rarity == "uncommon" and Color3.fromRGB(100, 200, 100) or
				                              itemDef.rarity == "rare" and Color3.fromRGB(100, 150, 255) or
				                              itemDef.rarity == "epic" and Color3.fromRGB(200, 100, 255) or
				                              Color3.fromRGB(255, 200, 100) -- legendary

				if recipe.output.quantity > 1 then
					resultQuantity.Text = tostring(recipe.output.quantity)
				else
					resultQuantity.Text = ""
				end

				craftButton.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
				craftButton.Text = "CRAFT"
				craftButton.Active = true
			end
		else
			resultImage.Visible = false
			resultQuantity.Text = ""
			craftButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			craftButton.Text = "NO RECIPE"
			craftButton.Active = false
		end
	end
end

-- Função para atualizar tudo
local function updateInventory()
	updateInventoryGrid()
	updateCraftingGrid()
end

-- Event handlers para crafting
craftButton.MouseButton1Click:Connect(function()
	local recipe = checkCraftingRecipe()
	if recipe then
		local result = CraftRemote:InvokeServer(recipe.id)
		if result.success then
			print("✅ " .. result.message)
			-- Limpar crafting grid após craft bem-sucedido
			craftingSlots = {}
			wait(0.5)
			updateInventory()
		else
			print("❌ " .. result.message)
		end
	end
end)

-- Sistema de drag and drop simplificado (click to place)
-- Por enquanto, vamos implementar um sistema básico onde clicar em um item do inventário
-- o coloca no primeiro slot vazio do crafting grid

local selectedItem = nil

-- Handler para slots do inventário
for _, slot in pairs(inventoryGrid:GetChildren()) do
	if slot:IsA("Frame") and slot.Name:match("^Slot%d+$") then
		slot.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local slotNum = tonumber(slot.Name:match("%d+"))
				local inv = GetInventoryRemote:InvokeServer()
				local slotData = inv.slots[slotNum]

				if slotData then
					selectedItem = slotData.item
					print("📦 Selecionado: " .. selectedItem)
				end
			end
		end)
	end
end

-- Handler para slots de crafting
for _, slot in pairs(craftingGrid:GetChildren()) do
	if slot:IsA("Frame") and slot.Name:match("^CraftSlot_%d+_%d+$") then
		slot.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local row, col = slot.Name:match("CraftSlot_(%d+)_(%d+)")
				row, col = tonumber(row), tonumber(col)
				local slotKey = row .. "_" .. col

				if selectedItem then
					-- Colocar item no slot
					craftingSlots[slotKey] = selectedItem
					selectedItem = nil
					updateCraftingGrid()
					print("🔨 Item colocado no crafting grid")
				else
					-- Remover item do slot
					craftingSlots[slotKey] = nil
					updateCraftingGrid()
					print("🔨 Item removido do crafting grid")
				end
			end
		end)
	end
end

-- Função para alternar inventário
local function toggleInventory(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		inventoryWindow.Visible = not inventoryWindow.Visible
		if inventoryWindow.Visible then
			updateInventory()
		end
	end
	return Enum.ContextActionResult.Sink -- Bloqueia outras ações
end

-- Registrar ação com prioridade alta
ContextActionService:BindAction("ToggleInventory", toggleInventory, false, Enum.KeyCode.I)
ContextActionService:SetTitle("ToggleInventory", "Abrir/Fechar Inventário")
ContextActionService:SetPosition("ToggleInventory", UDim2.new(0, 0, 0, 0))

-- Inicializar
inventoryWindow.Visible = false
updateInventory()

print("✅ Inventory Client carregado! Pressione I para abrir")

-- Sistema de coleta de itens
local function setupItemCollection()
	-- Conectar aos itens spawnados
	workspace.SpawnedItems.ChildAdded:Connect(function(itemPart)
		if itemPart:IsA("Part") then
			local clickDetector = itemPart:FindFirstChild("ClickDetector")
			if clickDetector then
				clickDetector.MouseClick:Connect(function()
					local ItemSpawner = require(game.ServerScriptService.Server.ItemSpawner)
					local success = ItemSpawner.collectItem(player, itemPart)

					if success then
						print("✅ Collected item")
					else
						print("❌ Failed to collect item")
					end
				end)
			end
		end
	end)

	-- Conectar aos itens já existentes
	for _, itemPart in pairs(workspace.SpawnedItems:GetChildren()) do
		if itemPart:IsA("Part") then
			local clickDetector = itemPart:FindFirstChild("ClickDetector")
			if clickDetector then
				clickDetector.MouseClick:Connect(function()
					local ItemSpawner = require(game.ServerScriptService.Server.ItemSpawner)
					local success = ItemSpawner.collectItem(player, itemPart)

					if success then
						print("✅ Collected item")
					else
						print("❌ Failed to collect item")
					end
				end)
			end
		end
	end
end

setupItemCollection()
local function updateInventory()
	-- Limpar itens antigos
	for _, child in pairs(itemScroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local inv = GetInventoryRemote:InvokeServer()

	-- Mostrar itens
	for slotNum = 1, inv.maxSlots do
		local slot = inv.slots[slotNum]
		if slot then
			local itemDef = ItemDefinitions[slot.item]
			
			local itemFrame = Instance.new("Frame")
			itemFrame.Name = slot.item .. "_" .. slotNum
			itemFrame.Size = UDim2.new(1, 0, 0, 40)
			itemFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			itemFrame.BorderSizePixel = 0
			itemFrame.Parent = itemScroll

			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(0.7, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextSize = 12
			textLabel.Font = Enum.Font.Gotham
			textLabel.TextXAlignment = Enum.TextXAlignment.Left
			textLabel.Text = itemDef.name .. " x" .. slot.quantity
			textLabel.Parent = itemFrame
		end
	end

	-- Atualizar receitas
	for _, child in pairs(recipeScroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	for recipeId, recipe in pairs(CraftRecipes) do
		local canCraft = true
		local inputText = ""

		-- Verificar se pode craftar
		for itemId, needed in pairs(recipe.inputs) do
			local have = 0
			for slotNum = 1, inv.maxSlots do
				if inv.slots[slotNum] and inv.slots[slotNum].item == itemId then
					have += inv.slots[slotNum].quantity
				end
			end
			
			local rarity = have >= needed and "✓" or "✗"
			inputText = inputText .. itemId .. "(" .. have .. "/" .. needed .. ") "
			
			if have < needed then
				canCraft = false
			end
		end

		local recipeFrame = Instance.new("Frame")
		recipeFrame.Name = recipeId
		recipeFrame.Size = UDim2.new(1, 0, 0, 50)
		recipeFrame.BackgroundColor3 = canCraft and Color3.fromRGB(60, 80, 60) or Color3.fromRGB(80, 40, 40)
		recipeFrame.BorderSizePixel = 0
		recipeFrame.Parent = recipeScroll

		local recipeText = Instance.new("TextLabel")
		recipeText.Size = UDim2.new(0.65, 0, 1, 0)
		recipeText.BackgroundTransparency = 1
		recipeText.TextColor3 = Color3.fromRGB(255, 255, 255)
		recipeText.TextSize = 10
		recipeText.Font = Enum.Font.Gotham
		recipeText.TextXAlignment = Enum.TextXAlignment.Left
		recipeText.TextWrapped = true
		recipeText.Text = recipe.name .. "\n" .. inputText
		recipeText.Parent = recipeFrame

		local craftButton = Instance.new("TextButton")
		craftButton.Name = "CraftBtn"
		craftButton.Size = UDim2.new(0.3, -5, 1, 0)
		craftButton.Position = UDim2.new(0.65, 5, 0, 0)
		craftButton.BackgroundColor3 = canCraft and Color3.fromRGB(100, 200, 100) or Color3.fromRGB(100, 100, 100)
		craftButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		craftButton.TextSize = 11
		craftButton.Font = Enum.Font.GothamBold
		craftButton.Text = "CRAFT"
		craftButton.Active = canCraft
		craftButton.Parent = recipeFrame

		craftButton.MouseButton1Click:Connect(function()
			local result = CraftRemote:InvokeServer(recipeId)
			if result.success then
				print("✅ " .. result.message)
				wait(0.5)
				updateInventory()
			else
				print("❌ " .. result.message)
			end
		end)
	end
end

-- Função para alternar inventário
local function toggleInventory(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		inventoryWindow.Visible = not inventoryWindow.Visible
		if inventoryWindow.Visible then
			updateInventory()
		end
	end
	return Enum.ContextActionResult.Sink -- Bloqueia outras ações
end

-- Registrar ação com prioridade alta
ContextActionService:BindAction("ToggleInventory", toggleInventory, false, Enum.KeyCode.I)
ContextActionService:SetTitle("ToggleInventory", "Abrir/Fechar Inventário")
ContextActionService:SetPosition("ToggleInventory", UDim2.new(0, 0, 0, 0))

-- Inicializar
inventoryWindow.Visible = false
updateInventory()

print("✅ Inventory Client carregado! Pressione I para abrir")
]]></string>
          </Properties>
