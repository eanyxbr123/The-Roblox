        <Item class="LocalScript" referent="33">
          <Properties>
            <string name="Name">AchievementClient</string>
            <string name="Source"><![CDATA[-- AchievementClient.client.luau
-- UI de conquistas

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetAchievementsRemote = RemotesFolder:FindFirstChild("GetAchievements")
local AchievementUnlockedEvent = RemotesFolder:FindFirstChild("AchievementUnlocked")

print("🏆 AchievementClient pronto")

if not GetAchievementsRemote then
	warn("⚠️  GetAchievementsRemote não encontrado")
	return
end

-- Criar UI
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

local achievementFrame = Instance.new("Frame")
achievementFrame.Name = "AchievementFrame"
achievementFrame.Size = UDim2.new(0.5, 0, 0.8, 0)
achievementFrame.Position = UDim2.new(0.25, 0, 0.1, 0)
achievementFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
achievementFrame.BorderSizePixel = 0
achievementFrame.Visible = false
achievementFrame.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = achievementFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
title.TextColor3 = Color3.fromRGB(255, 215, 0)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Text = "🏆 CONQUISTAS"
title.Parent = achievementFrame

local achievementList = Instance.new("ScrollingFrame")
achievementList.Size = UDim2.new(1, -20, 1, -70)
achievementList.Position = UDim2.new(0, 10, 0, 60)
achievementList.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
achievementList.BorderSizePixel = 0
achievementList.ScrollBarThickness = 8
achievementList.Parent = achievementFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = achievementList

-- Atualizar conquistas
local function refreshAchievements()
	for _, item in pairs(achievementList:GetChildren()) do
		if item:IsA("Frame") then
			item:Destroy()
		end
	end
	
	local achievements = GetAchievementsRemote:InvokeServer()
	if not achievements then return end
	
	for _, achievement in pairs(achievements) do
		local achFrame = Instance.new("Frame")
		achFrame.Size = UDim2.new(1, -10, 0, 50)
		achFrame.BackgroundColor3 = achievement.completed and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(80, 80, 80)
		achFrame.BorderSizePixel = 0
		achFrame.Parent = achievementList
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextSize = 12
		label.Font = Enum.Font.Gotham
		label.Text = achievement.icon .. " " .. achievement.name .. " (" .. achievement.progress .. "/" .. achievement.requirement .. ")"
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = achFrame
	end
	
	achievementList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

-- Abrir/fechar com A
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.A then
		achievementFrame.Visible = not achievementFrame.Visible
		if achievementFrame.Visible then
			refreshAchievements()
			print("✅ Conquistas abertas")
		end
	end
end)

-- Notificação ao desbloquear
if AchievementUnlockedEvent then
	AchievementUnlockedEvent.OnClientEvent:Connect(function(achievement)
		print("🏆 Conquistado: " .. achievement.name)
		
		local notif = Instance.new("TextLabel")
		notif.Size = UDim2.new(0, 300, 0, 50)
		notif.Position = UDim2.new(0.5, -150, 0.8, 0)
		notif.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
		notif.TextColor3 = Color3.fromRGB(255, 255, 255)
		notif.TextSize = 14
		notif.Font = Enum.Font.GothamBold
		notif.Text = "🏆 " .. achievement.name
		notif.Parent = screenGui
		
		game:GetService("Debris"):AddItem(notif, 3)
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="34">
          <Properties>
            <string name="Name">ArmorClient</string>
            <string name="Source"><![CDATA[-- ArmorClient.client.luau
-- UI de armaduras

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetArmorRemote = RemotesFolder:FindFirstChild("GetArmor")
local EquipArmorRemote = RemotesFolder:FindFirstChild("EquipArmor")

-- Modules
local ArmorDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ArmorDefinitions"))

print("🛡️ ArmorClient pronto")

if not GetArmorRemote then
	warn("⚠️  GetArmorRemote não encontrado")
	return
end

-- Criar UI
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

local armorFrame = Instance.new("Frame")
armorFrame.Name = "ArmorFrame"
armorFrame.Size = UDim2.new(0.4, 0, 0.6, 0)
armorFrame.Position = UDim2.new(0.3, 0, 0.2, 0)
armorFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
armorFrame.BorderSizePixel = 0
armorFrame.Visible = false
armorFrame.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = armorFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
title.TextColor3 = Color3.fromRGB(200, 100, 200)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Text = "🛡️ ARMADURAS"
title.Parent = armorFrame

local equippedLabel = Instance.new("TextLabel")
equippedLabel.Size = UDim2.new(1, 0, 0, 40)
equippedLabel.Position = UDim2.new(0, 0, 0, 50)
equippedLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
equippedLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
equippedLabel.TextSize = 12
equippedLabel.Font = Enum.Font.Gotham
equippedLabel.Text = "Equipado: Nenhum"
equippedLabel.Parent = armorFrame

local armorList = Instance.new("ScrollingFrame")
armorList.Size = UDim2.new(1, -20, 1, -120)
armorList.Position = UDim2.new(0, 10, 0, 100)
armorList.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
armorList.BorderSizePixel = 0
armorList.ScrollBarThickness = 8
armorList.Parent = armorFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = armorList

-- Atualizar UI
local function refreshArmor()
	-- Limpar lista
	for _, item in pairs(armorList:GetChildren()) do
		if item:IsA("TextButton") then
			item:Destroy()
		end
	end
	
	-- Equipado
	local equipped = GetArmorRemote:InvokeServer()
	if equipped then
		equippedLabel.Text = "Equipado: " .. equipped.icon .. " " .. equipped.name .. " (DEF+" .. equipped.defense .. ")"
	else
		equippedLabel.Text = "Equipado: Nenhum"
	end
	
	-- Lista de armaduras
	for armorId, armor in pairs(ArmorDefinitions) do
		local armorBtn = Instance.new("TextButton")
		armorBtn.Size = UDim2.new(1, -10, 0, 60)
		armorBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 100)
		armorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		armorBtn.TextSize = 12
		armorBtn.Font = Enum.Font.Gotham
		armorBtn.Text = armor.icon .. " " .. armor.name .. " (DEF+" .. armor.defense .. ") | 💰" .. armor.price.money .. " 💎" .. armor.price.crystals
		armorBtn.Parent = armorList
		
		armorBtn.MouseButton1Click:Connect(function()
			local result = EquipArmorRemote:InvokeServer(armorId)
			if result and result.success then
				print("✅ " .. result.message)
				refreshArmor()
			end
		end)
	end
	
	armorList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

-- Abrir com E (se não ocupado)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E then
		armorFrame.Visible = not armorFrame.Visible
		if armorFrame.Visible then
			refreshArmor()
			print("✅ Armaduras abertas")
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">CombatClient</string>
            <string name="Source"><![CDATA[-- CombatClient.client.luau
-- Cliente para combate

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local AttackRemote = RemotesFolder:FindFirstChild("Attack")
local TakeDamageEvent = RemotesFolder:FindFirstChild("TakeDamage")

print("⚔️ CombatClient pronto")

if not AttackRemote then
	warn("⚠️  AttackRemote não encontrado")
	return
end

-- Combate ao clique
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if mouse.Target then
			local target = mouse.Target
			
			-- Se clicou em um mob
			if target.Parent and target.Parent:FindFirstChild("Humanoid") then
				local mob = target.Parent
				print("⚔️ Atacando mob...")
				
				local result = AttackRemote:InvokeServer("mob", mob)
				if result and result.success then
					print("✅ " .. (result.killed and "Mob morreu!" or "Danificou mob"))
				end
			end
		end
	end
end)

-- Listener para dano recebido
if TakeDamageEvent then
	TakeDamageEvent.OnClientEvent:Connect(function(targetType, target, damage)
		print("💔 Recebeu " .. damage .. " de dano")
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="36">
          <Properties>
            <string name="Name">CraftingClient</string>
            <string name="Source"><![CDATA[-- CraftingClient.client.luau
-- Interface de crafting

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local CraftRecipes = require(ReplicatedStorage.Shared.CraftRecipes)
local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetInventoryRemote = RemotesFolder:WaitForChild("GetInventory")
local CraftRemote = RemotesFolder:FindFirstChild("Craft")

if not CraftRemote then
	warn("⚠️  CraftRemote não encontrado")
	return
end

print("🔨 CraftingClient pronto")

-- Criar UI de crafting
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

local craftFrame = Instance.new("Frame")
craftFrame.Name = "CraftFrame"
craftFrame.Size = UDim2.new(0, 300, 0.7, 0)
craftFrame.Position = UDim2.new(1, -320, 0, 100)
craftFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
craftFrame.BorderSizePixel = 0
craftFrame.Visible = false
craftFrame.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = craftFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
title.TextColor3 = Color3.fromRGB(255, 200, 0)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.Text = "🔨 CRAFTING"
title.Parent = craftFrame

local listFrame = Instance.new("Frame")
listFrame.Name = "ListFrame"
listFrame.Size = UDim2.new(1, -20, 1, -60)
listFrame.Position = UDim2.new(0, 10, 0, 50)
listFrame.BackgroundTransparency = 1
listFrame.Parent = craftFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = listFrame

-- Atualizar lista de crafting
local function refreshCraftList()
	for _, item in pairs(listFrame:GetChildren()) do
		if item:IsA("Frame") then
			item:Destroy()
		end
	end
	
	local inv = GetInventoryRemote:InvokeServer()
	if not inv then return end
	
	for _, recipe in pairs(CraftRecipes) do
		-- Verificar se tem itens
		local canCraft = true
		for itemId, needed in pairs(recipe.inputs) do
			local count = 0
			for i = 1, inv.maxSlots do
				if inv.slots[i] and inv.slots[i].item == itemId then
					count = count + inv.slots[i].quantity
				end
			end
			if count < needed then
				canCraft = false
				break
			end
		end
		
		-- Criar item de crafting
		local recipeFrame = Instance.new("Frame")
		recipeFrame.Name = recipe.id
		recipeFrame.Size = UDim2.new(1, 0, 0, 50)
		recipeFrame.BackgroundColor3 = canCraft and Color3.fromRGB(50, 100, 50) or Color3.fromRGB(80, 80, 80)
		recipeFrame.BorderSizePixel = 0
		recipeFrame.Parent = listFrame
		
		local recipeName = Instance.new("TextLabel")
		recipeName.Size = UDim2.new(0.6, 0, 1, 0)
		recipeName.BackgroundTransparency = 1
		recipeName.TextColor3 = Color3.fromRGB(255, 255, 255)
		recipeName.TextSize = 12
		recipeName.Font = Enum.Font.Gotham
		recipeName.Text = recipe.name
		recipeName.TextXAlignment = Enum.TextXAlignment.Left
		recipeName.Parent = recipeFrame
		
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(0.4, -5, 1, -5)
		button.Position = UDim2.new(0.6, 5, 0, 2.5)
		button.BackgroundColor3 = Color3.fromRGB(100, 150, 100)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextSize = 12
		button.Font = Enum.Font.GothamBold
		button.Text = canCraft and "CRAFT" or "🔒"
		button.Parent = recipeFrame
		
		if canCraft then
			button.MouseButton1Click:Connect(function()
				local result = CraftRemote:InvokeServer(recipe.id)
				if result.success then
					print("✅ " .. result.message)
					refreshCraftList()
				else
					print("❌ " .. result.message)
				end
			end)
		end
	end
end

-- Abrir/fechar com C
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.C then
		craftFrame.Visible = not craftFrame.Visible
		if craftFrame.Visible then
			refreshCraftList()
			print("✅ Crafting aberto")
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="37">
          <Properties>
            <string name="Name">HUDClient</string>
            <string name="Source"><![CDATA[-- HUDClient.client.luau
-- Mostra HUD com vida, fome, noite, som

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetStatsRemote = RemotesFolder:FindFirstChild("GetStats")
local StatsChangedEvent = RemotesFolder:FindFirstChild("StatsChanged")
local DayNightChangedEvent = RemotesFolder:FindFirstChild("DayNightChanged")

print("📊 HUDClient pronto")

-- Criar HUD
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

-- HUD Container
local hudContainer = Instance.new("Frame")
hudContainer.Name = "HUDContainer"
hudContainer.Size = UDim2.new(0.3, 0, 0.25, 0)
hudContainer.Position = UDim2.new(0, 10, 0, 10)
hudContainer.BackgroundTransparency = 0.2
hudContainer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
hudContainer.BorderSizePixel = 0
hudContainer.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = hudContainer

-- HUD Labels
local hudLayout = Instance.new("UIListLayout")
hudLayout.Padding = UDim.new(0, 5)
hudLayout.Parent = hudContainer

local healthLabel = Instance.new("TextLabel")
healthLabel.Name = "HealthLabel"
healthLabel.Size = UDim2.new(1, -10, 0, 30)
healthLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
healthLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
healthLabel.TextSize = 12
healthLabel.Font = Enum.Font.Gotham
healthLabel.Text = "❤️ Vida: 100/100"
healthLabel.TextXAlignment = Enum.TextXAlignment.Left
healthLabel.Parent = hudContainer

local hungerLabel = Instance.new("TextLabel")
hungerLabel.Name = "HungerLabel"
hungerLabel.Size = UDim2.new(1, -10, 0, 30)
hungerLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
hungerLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
hungerLabel.TextSize = 12
hungerLabel.Font = Enum.Font.Gotham
hungerLabel.Text = "🍗 Fome: 100/100"
hungerLabel.TextXAlignment = Enum.TextXAlignment.Left
hungerLabel.Parent = hudContainer

local nightLabel = Instance.new("TextLabel")
nightLabel.Name = "NightLabel"
nightLabel.Size = UDim2.new(1, -10, 0, 30)
nightLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
nightLabel.TextColor3 = Color3.fromRGB(150, 150, 255)
nightLabel.TextSize = 12
nightLabel.Font = Enum.Font.Gotham
nightLabel.Text = "🌙 Noite: 0/99"
nightLabel.TextXAlignment = Enum.TextXAlignment.Left
nightLabel.Parent = hudContainer

local soundLabel = Instance.new("TextLabel")
soundLabel.Name = "SoundLabel"
soundLabel.Size = UDim2.new(1, -10, 0, 30)
soundLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
soundLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
soundLabel.TextSize = 12
soundLabel.Font = Enum.Font.Gotham
soundLabel.Text = "🔊 Som: 0"
soundLabel.TextXAlignment = Enum.TextXAlignment.Left
soundLabel.Parent = hudContainer

-- Atualizar HUD
RunService.RenderStepped:Connect(function()
	if GetStatsRemote then
		local stats = GetStatsRemote:InvokeServer()
		if stats then
			healthLabel.Text = string.format("❤️ Vida: %.0f/%.0f", stats.health, stats.maxHealth)
			hungerLabel.Text = string.format("🍗 Fome: %.0f/%.0f", stats.hunger, stats.maxHunger)
			
			-- Mudar cor baseado na vida
			if stats.health < 30 then
				healthLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
			else
				healthLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
			end
		end
	end
end)

-- Listener para mudanças de dia/noite
if DayNightChangedEvent then
	DayNightChangedEvent.OnClientEvent:Connect(function(data)
		nightLabel.Text = string.format("🌙 Noite: %d/%d", data.night, data.maxNights)
		if data.isNight then
			nightLabel.TextColor3 = Color3.fromRGB(100, 100, 200)
		else
			nightLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
		end
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">InventoryClient</string>
            <string name="Source"><![CDATA[-- InventoryClient.client.luau
-- Inventário simples sem drag-drop visual

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")

local ItemDefinitions = require(ReplicatedStorage.Shared.ItemDefinitions)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetInventoryRemote = RemotesFolder:WaitForChild("GetInventory")
local ItemCollectedEvent = RemotesFolder:FindFirstChild("ItemCollected")

if not ItemCollectedEvent then
	warn("⚠️  ItemCollectedEvent não encontrado")
end

-- Criar GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "InventoryGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Name = "InventoryFrame"
frame.Size = UDim2.new(0, 400, 0, 300)
frame.Position = UDim2.new(0.5, -200, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Visible = false
frame.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
title.TextColor3 = Color3.fromRGB(255, 200, 0)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.Text = "📦 INVENTÁRIO"
title.Parent = frame

local listFrame = Instance.new("Frame")
listFrame.Name = "ListFrame"
listFrame.Size = UDim2.new(1, -20, 1, -60)
listFrame.Position = UDim2.new(0, 10, 0, 50)
listFrame.BackgroundTransparency = 1
listFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = listFrame

-- Estado
local currentInv = nil
local selectedSlot = nil

-- Refresh UI
local function refreshUI()
	if not currentInv then return end
	
	-- Limpar items antigos
	for _, item in pairs(listFrame:GetChildren()) do
		if item:IsA("Frame") then
			item:Destroy()
		end
	end
	
	-- Mostrar itens
	for i = 1, currentInv.maxSlots do
		local data = currentInv.slots[i]
		if data then
			local itemFrame = Instance.new("Frame")
			itemFrame.Name = "Item_" .. i
			itemFrame.Size = UDim2.new(1, 0, 0, 30)
			itemFrame.BackgroundColor3 = selectedSlot == i and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(50, 50, 50)
			itemFrame.BorderSizePixel = 0
			itemFrame.Parent = listFrame
			
			local itemName = Instance.new("TextLabel")
			itemName.Size = UDim2.new(0.5, 0, 1, 0)
			itemName.BackgroundTransparency = 1
			itemName.TextColor3 = Color3.fromRGB(255, 255, 255)
			itemName.TextSize = 14
			itemName.Font = Enum.Font.Gotham
			itemName.Text = ItemDefinitions[data.item].name .. " x" .. data.quantity
			itemName.TextXAlignment = Enum.TextXAlignment.Left
			itemName.Parent = itemFrame
			
			local button = Instance.new("TextButton")
			button.Size = UDim2.new(0.5, 0, 1, 0)
			button.Position = UDim2.new(0.5, 0, 0, 0)
			button.BackgroundTransparency = 1
			button.TextColor3 = Color3.fromRGB(100, 200, 100)
			button.TextSize = 12
			button.Font = Enum.Font.GothamBold
			button.Text = "Usar"
			button.Parent = itemFrame
			
			button.MouseButton1Click:Connect(function()
				print("🎯 Clicou em: " .. ItemDefinitions[data.item].name)
				selectedSlot = i
				refreshUI()
			end)
		end
	end
	
	-- Atualizar peso
	title.Text = string.format("📦 INVENTÁRIO | %.1f/%.1f kg", currentInv.totalWeight, currentInv.maxWeight)
end

-- Listener para quando item é coletado
if ItemCollectedEvent then
	ItemCollectedEvent.OnClientEvent:Connect(function(itemId, quantity)
		print("🎁 Item coletado: " .. itemId .. " x" .. quantity)
		
		-- Atualizar inventário
		currentInv = GetInventoryRemote:InvokeServer()
		if frame.Visible then
			refreshUI()
		end
		
		-- Mostrar notificação
		local notif = Instance.new("TextLabel")
		notif.Size = UDim2.new(0, 300, 0, 40)
		notif.Position = UDim2.new(0.5, -150, 0, 20)
		notif.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
		notif.TextColor3 = Color3.fromRGB(255, 255, 255)
		notif.TextSize = 14
		notif.Font = Enum.Font.GothamBold
		notif.Text = "✅ " .. itemId .. " x" .. quantity
		notif.Parent = screenGui
		
		game:GetService("Debris"):AddItem(notif, 2)
	end)
end

-- Abrir/fechar com I
local function toggle(_, state)
	if state == Enum.UserInputState.Begin then
		frame.Visible = not frame.Visible
		if frame.Visible then
			currentInv = GetInventoryRemote:InvokeServer()
			selectedSlot = nil
			refreshUI()
			print("✅ Inventário aberto")
		else
			print("❌ Inventário fechado")
		end
	end
end

ContextActionService:BindAction("inv_toggle", toggle, false, Enum.KeyCode.I)

print("✅ InventoryClient pronto")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="39">
          <Properties>
            <string name="Name">LobbyClient</string>
            <string name="Source"><![CDATA[-- LobbyClient.client.luau
-- Cliente do lobby e matchmaking

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local EnterGameRemote = RemotesFolder:FindFirstChild("EnterGame")

print("🎮 LobbyClient pronto")

if not EnterGameRemote then
	warn("⚠️  EnterGameRemote não encontrado")
	return
end

-- Criar UI do Lobby
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

local lobbyFrame = Instance.new("Frame")
lobbyFrame.Name = "LobbyFrame"
lobbyFrame.Size = UDim2.new(1, 0, 1, 0)
lobbyFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
lobbyFrame.BorderSizePixel = 0
lobbyFrame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 80)
title.BackgroundColor3 = Color3.fromRGB(10, 10, 30)
title.TextColor3 = Color3.fromRGB(255, 200, 0)
title.TextSize = 32
title.Font = Enum.Font.GothamBold
title.Text = "🎮 99 NOITES SURVIVAL"
title.Parent = lobbyFrame

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, 0, 0, 40)
subtitle.Position = UDim2.new(0, 0, 0, 80)
subtitle.BackgroundTransparency = 1
subtitle.TextColor3 = Color3.fromRGB(200, 200, 200)
subtitle.TextSize = 16
subtitle.Font = Enum.Font.Gotham
subtitle.Text = "Escolha uma zona e um tamanho de grupo para começar"
subtitle.Parent = lobbyFrame

-- Container de zonas
local zonesContainer = Instance.new("Frame")
zonesContainer.Name = "ZonesContainer"
zonesContainer.Size = UDim2.new(1, 0, 0.6, 0)
zonesContainer.Position = UDim2.new(0, 0, 0, 130)
zonesContainer.BackgroundTransparency = 1
zonesContainer.Parent = lobbyFrame

local zoneLayout = Instance.new("UIGridLayout")
zoneLayout.CellSize = UDim2.new(0.25, -10, 0.5, -10)
zoneLayout.CellPadding = UDim2.new(0, 10, 0, 10)
zoneLayout.FillDirection = Enum.FillDirection.Horizontal
zoneLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
zoneLayout.VerticalAlignment = Enum.VerticalAlignment.Top
zoneLayout.Parent = zonesContainer

-- Criar botões de zonas
for i = 1, 3 do
	local zoneButton = Instance.new("TextButton")
	zoneButton.Name = "Zone" .. i
	zoneButton.BackgroundColor3 = Color3.fromRGB(50, 100, 150)
	zoneButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	zoneButton.TextSize = 20
	zoneButton.Font = Enum.Font.GothamBold
	zoneButton.Text = "🎯 ZONA " .. i
	zoneButton.Parent = zonesContainer
	
	local UICorner = Instance.new("UICorner")
	UICorner.CornerRadius = UDim.new(0, 8)
	UICorner.Parent = zoneButton
	
	-- Sub-frame com opções de grupos
	local groupsFrame = Instance.new("Frame")
	groupsFrame.Name = "GroupsFrame"
	groupsFrame.Size = UDim2.new(1, -20, 0, 150)
	groupsFrame.Position = UDim2.new(0, 10, 0.5, 0)
	groupsFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	groupsFrame.BorderSizePixel = 0
	groupsFrame.Visible = false
	groupsFrame.Parent = zoneButton
	
	local groupLayout = Instance.new("UIListLayout")
	groupLayout.Padding = UDim.new(0, 5)
	groupLayout.Parent = groupsFrame
	
	-- Botões de tamanho de grupo
	for groupSize = 1, 5 do
		local groupButton = Instance.new("TextButton")
		groupButton.Size = UDim2.new(1, -10, 0, 25)
		groupButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
		groupButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		groupButton.TextSize = 12
		groupButton.Font = Enum.Font.GothamBold
		groupButton.Text = "Grupo de " .. groupSize
		groupButton.Parent = groupsFrame
		
		groupButton.MouseButton1Click:Connect(function()
			print("🎮 Entrando na Zona " .. i .. " com grupo de " .. groupSize)
			local result = EnterGameRemote:InvokeServer(i, groupSize)
			if result.success then
				print("✅ " .. result.message)
			else
				print("❌ " .. result.message)
			end
		end)
	end
	
	-- Mostrar/esconder opções ao clicar
	zoneButton.MouseButton1Click:Connect(function()
		groupsFrame.Visible = not groupsFrame.Visible
	end)
end

print("✅ Lobby interface criado")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="40">
          <Properties>
            <string name="Name">MiningClient</string>
            <string name="Source"><![CDATA[-- MiningClient.client.luau
-- Cliente para mineração de blocos

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local MineBlockRemote = RemotesFolder:WaitForChild("MineBlock")

print("⛏️  MiningClient pronto")

-- Sistema de clique para mineração
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if mouse.Target then
			local target = mouse.Target
			
			-- Se é um bloco no mundo
			if target:GetAttribute("blockType") then
				print("🎯 Clicou em bloco: " .. target.Name)
				
				local result = MineBlockRemote:InvokeServer(target)
				
				if result and result.success then
					print("✅ " .. result.message)
				else
					print("❌ " .. (result and result.message or "Erro desconhecido"))
				end
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="41">
          <Properties>
            <string name="Name">MultiplayerClient</string>
            <string name="Source"><![CDATA[-- MultiplayerClient.client.luau
-- Renderizar outros jogadores

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local PlayerPositionEvent = RemotesFolder:FindFirstChild("PlayerPosition")

print("👥 MultiplayerClient pronto")

if not PlayerPositionEvent then
	warn("⚠️  PlayerPositionEvent não encontrado")
	return
end

-- Rastrear modelos dos outros jogadores
local otherPlayerModels = {}

-- Criar modelo visual para outro jogador
local function createPlayerModel(userId)
	if otherPlayerModels[userId] then return end
	
	local model = Instance.new("Model")
	model.Name = "RemotePlayer_" .. userId
	
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(2, 2, 2)
	head.Color = Color3.fromRGB(255, 200, 150)
	head.Parent = model
	
	local humanoidRootPart = Instance.new("Part")
	humanoidRootPart.Name = "HumanoidRootPart"
	humanoidRootPart.Shape = Enum.PartType.Block
	humanoidRootPart.Size = Vector3.new(2, 5, 2)
	humanoidRootPart.Transparency = 1
	humanoidRootPart.CanCollide = true
	humanoidRootPart.Parent = model
	
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(math.huge, 0, math.huge)
	bodyVelocity.Parent = humanoidRootPart
	
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.Parent = model
	
	model.Parent = workspace
	
	otherPlayerModels[userId] = {
		model = model,
		humanoidRootPart = humanoidRootPart,
		bodyVelocity = bodyVelocity,
		head = head,
	}
	
	print("✅ Modelo criado para jogador " .. userId)
end

-- Atualizar posições
if PlayerPositionEvent then
	PlayerPositionEvent.OnClientEvent:Connect(function(playerPositions)
		for userId, pos in pairs(playerPositions) do
			if userId ~= player.UserId then
				if not otherPlayerModels[userId] then
					createPlayerModel(userId)
				end
				
				local model = otherPlayerModels[userId]
				if model and model.humanoidRootPart then
					model.humanoidRootPart.Position = pos.position
					model.humanoidRootPart.Orientation = pos.orientation
				end
			end
		end
	end)
end

-- Cleanup ao sair
Players.PlayerRemoving:Connect(function(p)
	if otherPlayerModels[p.UserId] then
		otherPlayerModels[p.UserId].model:Destroy()
		otherPlayerModels[p.UserId] = nil
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="42">
          <Properties>
            <string name="Name">ShopClient</string>
            <string name="Source"><![CDATA[-- ShopClient.client.luau
-- UI da loja

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local GetShopRemote = RemotesFolder:FindFirstChild("GetShop")
local BuyItemRemote = RemotesFolder:FindFirstChild("BuyItem")

print("🛍️ ShopClient pronto")

if not GetShopRemote then
	warn("⚠️  GetShopRemote não encontrado")
	return
end

-- Criar UI da loja
local screenGui = playerGui:FindFirstChild("InventoryGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
end

local shopFrame = Instance.new("Frame")
shopFrame.Name = "ShopFrame"
shopFrame.Size = UDim2.new(0.4, 0, 0.8, 0)
shopFrame.Position = UDim2.new(0.3, 0, 0.1, 0)
shopFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
shopFrame.BorderSizePixel = 0
shopFrame.Visible = false
shopFrame.Parent = screenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = shopFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
title.TextColor3 = Color3.fromRGB(255, 200, 100)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Text = "🛍️ LOJA"
title.Parent = shopFrame

local shopList = Instance.new("ScrollingFrame")
shopList.Size = UDim2.new(1, -20, 1, -70)
shopList.Position = UDim2.new(0, 10, 0, 60)
shopList.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
shopList.BorderSizePixel = 0
shopList.ScrollBarThickness = 8
shopList.Parent = shopFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = shopList

-- Atualizar loja
local function refreshShop()
	for _, item in pairs(shopList:GetChildren()) do
		if item:IsA("Frame") then
			item:Destroy()
		end
	end
	
	local shopItems = GetShopRemote:InvokeServer()
	if not shopItems then return end
	
	for _, item in pairs(shopItems) do
		local itemFrame = Instance.new("TextButton")
		itemFrame.Name = item.id
		itemFrame.Size = UDim2.new(1, -10, 0, 60)
		itemFrame.BackgroundColor3 = item.available and Color3.fromRGB(50, 80, 120) or Color3.fromRGB(80, 80, 80)
		itemFrame.TextColor3 = Color3.fromRGB(255, 255, 255)
		itemFrame.TextSize = 12
		itemFrame.Font = Enum.Font.GothamBold
		itemFrame.Text = (item.available and "✅ " or "❌ ") .. item.name .. " | 💰" .. item.price.money .. " 💎" .. item.price.crystals
		itemFrame.Parent = shopList
		
		if item.available then
			itemFrame.MouseButton1Click:Connect(function()
				local result = BuyItemRemote:InvokeServer(item.id)
				if result and result.success then
					print("✅ " .. result.message)
					refreshShop()
				else
					print("❌ " .. (result and result.message or "Erro"))
				end
			end)
		end
	end
	
	shopList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

-- Abrir/fechar com S
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.S then
		shopFrame.Visible = not shopFrame.Visible
		if shopFrame.Visible then
			refreshShop()
			print("✅ Loja aberta")
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">SoundClient</string>
            <string name="Source"><![CDATA[-- SoundClient.client.luau
-- Gera som ao andar, correr, etc

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local ReportSoundRemote = RemotesFolder:FindFirstChild("ReportSound")

print("🔊 SoundClient pronto")

if not ReportSoundRemote then
	warn("⚠️  ReportSoundRemote não encontrado")
	return
end

-- Estado
local currentSoundLevel = 0
local isRunning = false
local lastReportTime = 0

-- Detectar movimento
local keysPressed = {}
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A or
	   input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.D then
		keysPressed[input.KeyCode] = true
	end
	
	-- Correr com SHIFT
	if input.KeyCode == Enum.KeyCode.LeftShift then
		isRunning = true
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A or
	   input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.D then
		keysPressed[input.KeyCode] = false
	end
	
	if input.KeyCode == Enum.KeyCode.LeftShift then
		isRunning = false
	end
end)

-- Loop de som
RunService.Heartbeat:Connect(function()
	-- Calcular som baseado em movimento
	local soundLevel = 0
	
	-- Verificar se está movendo
	local isMoving = false
	for _, pressed in pairs(keysPressed) do
		if pressed then
			isMoving = true
			break
		end
	end
	
	if isMoving then
		if isRunning then
			soundLevel = 70  -- Correr = bem barulhento
		else
			soundLevel = 30  -- Andar = pouco barulho
		end
	end
	
	currentSoundLevel = soundLevel
	
	-- Reportar ao servidor a cada 0.5 segundos
	if tick() - lastReportTime > 0.5 and soundLevel > 0 then
		lastReportTime = tick()
		
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			pcall(function()
				ReportSoundRemote:InvokeServer(soundLevel, humanoidRootPart.Position)
			end)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
